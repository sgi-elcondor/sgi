{
  "name": "sgi",
  "version": "1.0.0",
  "description": "Sistema de Gestión Inmobiliaria - El Cóndor",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "test": "jest",
    "audit": "node tools/audit/run-all.js",
    "audit:offline": "node tools/audit/run-all.js --offline"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/setup-env.js"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "firebase-admin": "^13.8.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "connect-livereload": "^0.6.1",
    "esbuild": "^0.28.1",
    "jest": "^30.4.2",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgi-elcondor/sgi.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sgi-elcondor/sgi/issues"
  },
  "homepage": "https://github.com/sgi-elcondor/sgi#readme"
}
